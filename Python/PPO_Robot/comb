import os


class Config:
    # Environment parameters
    ENV_NAME = "HalfCheetah-v5"
    # Training parameters
    MAX_EPISODES = 10000
    MAX_TIMESTEPS = 1000
    UPDATE_TIMESTEP = 8192 
    LOG_INTERVAL = 20
    BATCH_SIZE = 1024
    REVARD_SCALE = 0.1


    # PPO hyperparameters
    ACTION_STD = 0.5
    ACTION_STD_MIN = 0.1
    LEARNING_RATE = 5e-5
    GAMMA = 0.99
    GAE_LAMBDA = 0.95
    K_EPOCHS = 10
    EPS_CLIP = 0.2
    ENTROPY_PEN = 0.001
    TARGET_KL = 0.03

    POLICY_CLIP = 0.5



    # Model parameters
    HIDDEN_UNITS = [256,256]
    DEVICE = "cuda"

    # Save/Load paths
    MODEL_DIR = "models"
    MODEL_NAME = "tests.pth"
    TENSORBOARD_LOG_DIR = "runs"
    LOAD_MODEL = True

    def __init__(self):
        # Create directories if they don't exist
        os.makedirs(self.MODEL_DIR, exist_ok=True)
        os.makedirs(self.TENSORBOARD_LOG_DIR,exist_ok=True)

